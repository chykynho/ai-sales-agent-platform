APP_NAME=AI Sales Agent Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=aiagent_dev_password
POSTGRES_DB=aiagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
BOOTSTRAP_TENANT_NAME=Demo Tenant
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# v0.2 LLM layer. Start with mock for zero-cost deterministic validation.
LLM_PROVIDER=mock
MOCK_MODEL=mock-v0.2

# Real OpenAI validation: set LLM_PROVIDER=openai and provide a project API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# LangGraph checkpoint deserialization hardening
LANGGRAPH_STRICT_MSGPACK=true

# v0.6 RAG / embeddings
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_MAX_UPLOAD_MB=10
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.15

# v0.8 WhatsApp Business / Meta Cloud API channel adapter
# Local values are for smoke tests only. Replace in real environments.
WHATSAPP_VERIFY_TOKEN=local-v08-verify-token
WHATSAPP_APP_SECRET=local-v08-app-secret-change-me
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=1048576
WHATSAPP_HTTP_TIMEOUT_SECONDS=20

# v0.9 Realtime Voice foundation
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TIMEOUT_SECONDS=30
VOICE_AUDIO_MAX_BYTES=5000000
VOICE_SESSION_MAX_MINUTES=60

# v0.10 Twilio Media Streams bridge laboratory
# Lab token is only for the local simulated Twilio client. Replace/disable outside local development.
VOICE_BRIDGE_LAB_ENABLED=true
VOICE_BRIDGE_LAB_TOKEN=local-v10-bridge-token-change-me
VOICE_BARGE_IN_ENABLED=true
VOICE_BRIDGE_PLAYBACK_SPEED=4.0

# v0.11 Production Telephony Hardening
# Ative somente quando os endpoints externos HTTPS/WSS e as credenciais Twilio estiverem configurados.
VOICE_PRODUCTION_ENABLED=false
TWILIO_REQUIRE_SIGNATURE=true
TWILIO_PUBLIC_BASE_URL=https://voice.example.com
TWILIO_WSS_BASE_URL=wss://voice.example.com
# Cada tenant referencia o nome da sua variavel de Auth Token em channel_accounts.access_token_env.
# Exemplo local/smoke: TWILIO_AUTH_TOKEN_SMOKE=troque-este-segredo
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
VOICE_VAD_RMS_THRESHOLD=450
VOICE_VAD_SILENCE_MS=700
VOICE_VAD_MIN_SPEECH_MS=240
VOICE_VAD_MAX_UTTERANCE_MS=15000
VOICE_PRODUCTION_FIRST_TURN_ONLY=true
